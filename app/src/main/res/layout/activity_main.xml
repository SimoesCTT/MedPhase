<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDPHASE"
            android:textSize="22sp"
            android:textColor="@color/accent"
            android:letterSpacing="0.2"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DICOM phase processing — research tool"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnLoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load DICOM"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No file loaded"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/spinnerMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnProcess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Process"
            android:enabled="false"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="METRICS"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:textColor="@color/text"
            android:fontFamily="monospace"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IMAGE PREVIEW"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:scaleType="centerInside"
            android:background="@color/card"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Research and educational tool. Not a medical device. Does not diagnose, treat, cure, or prevent any condition."
            android:textSize="10sp"
            android:textColor="@color/text_dim"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
